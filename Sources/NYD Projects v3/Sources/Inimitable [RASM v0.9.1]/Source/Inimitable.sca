:OnlinePlayerTeleportationSubMenu
Function 0 2
Push 4
Call @DrawBackground
PushString "Teleportation"
Call @AddMenuTitle
PushString "Self To Player"
Call @AddOption
PushString "Self Into Their Vehicle"
Call @AddOption
PushString "Player To Self (Vehicle)"
Call @AddOption
PushString "Player To Self (Foot)"
Call @AddOption
Call @GetCurrentOption
Switch [4 @OnlinePlayerTeleportationPlayerToMeInfo]
Jump @OnlinePlayerTeleportationOptions

:OnlinePlayerTeleportationPlayerToMeInfo
PushString "This might need pressing multiple times."
Call @AddInfo
Jump @OnlinePlayerTeleportationOptions

:OnlinePlayerTeleportationOptions
Call @CheckAPressed
JumpFalse @EndOnlinePlayerTeleportation
Call @GetCurrentOption
Switch [1 @OnlinePlayerTeleportationToPlayer][2 @OnlinePlayerTeleportationIntoTheirVehicle][3 @OnlinePlayerTeleportationPlayerVehicleToMe][4 @OnlinePlayerTeleportationPlayerToMe]

:OnlinePlayerTeleportationToPlayer
GetStatic 597
CallNative NETWORK_IS_PLAYER_ACTIVE 1 1
JumpFalse @EndOnlinePlayerTeleportation
GetStatic 597
CallNative GET_PLAYER_PED 1 1
Push 1
CallNative GET_ENTITY_COORDS 2 3
Call @TeleportToCoords
Jump @EndOnlinePlayerTeleportation

:OnlinePlayerTeleportationIntoTheirVehicle
GetStatic 597
CallNative NETWORK_IS_PLAYER_ACTIVE 1 1
JumpFalse @EndOnlinePlayerTeleportation
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative IS_PED_SITTING_IN_ANY_VEHICLE 1 1
JumpFalse @ErrorOnlinePlayerNotInVehicleTeleportation
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
CallNative ARE_ANY_VEHICLE_SEATS_FREE 1 1
JumpFalse @ErrorNoFreeSeats
Push -1
SetStatic 609
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
CallNative GET_ENTITY_MODEL 1 1
CallNative GET_VEHICLE_MODEL_NUMBER_OF_SEATS 1 1
Push 2
Sub
SetStatic 610
:FreeSeatLoopCheck
GetStatic 609
GetStatic 610
JumpGT @ErrorNoFreeSeats
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
GetStatic 609
CallNative IS_VEHICLE_SEAT_FREE 2 1
Push 1
JumpEQ @SetPedIntoVehicle
GetStatic 609
Push 1
Add
SetStatic 609
Jump @FreeSeatLoopCheck
:SetPedIntoVehicle
CallNative PLAYER_PED_ID 0 1
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
GetStatic 609
CallNative SET_PED_INTO_VEHICLE 3 0
Jump @EndOnlinePlayerTeleportation
:ErrorNoFreeSeats
PushString "Player's vehicle is full."
Push 0
Call @DrawNotification
Jump @EndOnlinePlayerTeleportation

:OnlinePlayerTeleportationPlayerVehicleToMe
GetStatic 597
CallNative NETWORK_IS_PLAYER_ACTIVE 1 1
JumpFalse @EndOnlinePlayerTeleportation
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative IS_PED_SITTING_IN_ANY_VEHICLE 1 1
JumpFalse @ErrorOnlinePlayerNotInVehicleTeleportation
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
Call @RequestControlOfEntity
JumpFalse @EndOnlinePlayerTeleportation
GetStatic 363
CallNative _0xECA8ACB9 1 0
GetStatic 597
CallNative GET_PLAYER_PED 1 1
CallNative GET_VEHICLE_PED_IS_USING 1 1
Call @NoClipGetEntity
Push 1
CallNative GET_ENTITY_COORDS 2 3
Push 1
Push 0
Push 0
Push 1
CallNative SET_ENTITY_COORDS 8 0
Jump @EndOnlinePlayerTeleportation
:ErrorOnlinePlayerNotInVehicleTeleportation
PushString "Player is not in a vehicle."
Push 0
Call @DrawNotification
Jump @EndOnlinePlayerTeleportation

